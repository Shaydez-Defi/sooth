# Frontend env — not hardcoded. Point at local Fastify API or deployed URL.
# In dev (Codespaces or local), leave empty to use vite proxy → http://localhost:3000 (requires `npm run api` running).
# Only set if hitting a remote deployed API, e.g. https://api.sooth.example.com
# VITE_API_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=
